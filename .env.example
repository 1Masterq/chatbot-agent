# The handbook chatbot needs no AI API key.
# Configure these private mail-sender settings once on the server operator's machine.
# Do not commit .env.local or share SMTP_PASSWORD.
STAFF_EMAIL=your_staff_inbox@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender_account@gmail.com
SMTP_PASSWORD=your_provider_app_password
# Optional; defaults to SMTP_USERNAME.
SMTP_FROM=
