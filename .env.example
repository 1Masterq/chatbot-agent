# Copy this file to .env.local, then replace the placeholder with your provider key.
# Never commit the real key.
AI_API_KEY=your_real_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional staff handoff email. Configure only with school-approved sender settings.
STAFF_EMAIL=school_support@example.edu
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USERNAME=your_school_sender_account
SMTP_PASSWORD=your_mail_provider_password
# Optional; defaults to SMTP_USERNAME.
SMTP_FROM=
